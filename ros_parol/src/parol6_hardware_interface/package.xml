<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>parol6_hardware_interface</name>
  <version>0.1.0</version>
  <description>
    ros2_control SystemInterface plugin for the PAROL6 arm. Talks to the
    parol6_bridge daemon over a local TCP loopback socket, which in turn
    talks to parol6-server over UDP.
  </description>
  <maintainer email="gupyfish@gmail.com">gupyfish</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/parol6_hardware_interface.xml" />
  </export>
</package>
